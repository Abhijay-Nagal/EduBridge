{
  "name": "edubridge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Lightweight LMS for small-scale tuition centres and coaching institutes",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:server\" \"vite\"",
    "dev:web": "vite",
    "server": "node --watch-path=server server/index.js",
    "start": "node server/index.js",
    "db:reset": "node server/index.js --reset",
    "build": "vite build",
    "preview": "vite preview",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^4.22.3",
    "idb-keyval": "^6.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.6",
    "postcss": "^8.4.47",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5"
  },
  "engines": {
    "node": ">=20"
  }
}
